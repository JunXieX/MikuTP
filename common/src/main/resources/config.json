{
  "config_version": 1,
  "storage": {
    "type": "SQLITE",
    "table_prefix": "mikutp_",
    "mysql": {
      "host": "localhost",
      "port": 3306,
      "database": "mikutp",
      "user": "mikutp",
      "password": "",
      "use_ssl": false
    },
    "pool_size": 8
  },
  "cross_server": {
    "enabled": false,
    "server_id": "server",
    "poll_interval_ms": 1000,
    "request_expiry_seconds": 60
  },
  "teleport": {
    "warmup_seconds": 3,
    "move_threshold_blocks": 0.0,
    "cancel_on_damage": true,
    "sounds": true,
    "cooldowns": {
      "home": 5,
      "warp": 5,
      "tpa": 10,
      "wild": 60,
      "back": 10
    }
  },
  "home": {
    "default_limit": 5,
    "name_pattern": "[a-zA-Z0-9_-]{1,32}"
  },
  "warp": {
    "enabled": true
  },
  "tpa": {
    "enabled": true,
    "request_expiry_seconds": 60,
    "block_duration_minutes": 10
  },
  "back": {
    "enabled": true,
    "save_on_death": true,
    "save_on_teleport": true
  },
  "wild": {
    "enabled": true,
    "world_mode": "CURRENT",
    "worlds": ["world"],
    "min_radius": 500,
    "max_radius": 5000,
    "center": "SPAWN",
    "max_attempts": 10,
    "blocked_biome_tags": ["is_ocean", "is_deep_ocean", "is_river", "is_beach"],
    "blocked_biomes": [],
    "require_safe_landing": true
  },
  "dialogs": {
    "enabled": true,
    "list_page_size": 12
  },
  "language_file": "messages_zh_cn.json",
  "parse_placeholder_api": true
}
